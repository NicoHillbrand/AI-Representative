# Copy to .env and fill in.

# Your Google Gemini API key. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Port the server listens on.
PORT=8080

# Public base URL (used in the API docs). No trailing slash.
PUBLIC_BASE_URL=https://ai.nicohillbrand.com

# Model for chat + negotiation replies. Defaults to gemini-3.5-flash (newest).
# Cheaper current-gen option: gemini-3.1-flash-lite (~6x cheaper output).
MODEL=gemini-3.5-flash

# Model for the negotiation classifier (a simple task). Kept cheap on purpose.
CLASSIFIER_MODEL=gemini-3.1-flash-lite

# Optional: comma-separated origins allowed to call the API from a browser.
# Leave unset to allow same-origin only. Use * to allow all (fine for a public demo API).
CORS_ORIGINS=*

# --- Huddle desktop overlay (specs/desktop-call-overlay.md) -------------------
# Bootstrap code(s) for the FIRST member only (comma-separated) — they join
# friendless. Everyone after that joins with a friend's personal code from
# the overlay (settings → My friend code), which also makes the two friends.
HUDDLE_INVITE_CODES=

# Optional Telegram bot token (@BotFather). One bot, two jobs: representative
# chat for anyone who messages it, and — for Huddle members who link it in the
# overlay's settings — notifications when the overlay is closed, plus setting
# availability by command ("/up 60 coworking", or bare "/up" for a picker).
TELEGRAM_BOT_TOKEN=
# The group call room the overlay's "Start call" button opens (Discord/Meet/Jitsi...).
HUDDLE_CALL_LINK=

# --- Forwarding feed + owner API (src/forwarding/) ----------------------------
# The owner API (private feed + read-only Huddle roster) has TWO token scopes,
# so a read-only consumer like your own agent can't change anything if it leaks.
#
# Read-only token — safe to hand to an agent: lists the feed (GET /api/forwards)
# and reads your roster (GET /api/owner/roster). Cannot mutate. Blank = no read
# access.
OWNER_READ_TOKEN=
# Write token — full authority: create forwards, mark read. Keep this OFF your
# agent (make changes via Telegram/overlay). Also satisfies read. Blank = no
# write access. OWNER_TOKEN is accepted as an alias for this (back-compat), and
# whichever you set also powers the /forwards.html viewer.
OWNER_WRITE_TOKEN=
# Your Huddle member id, so the read-only roster knows whose availability to
# return (callers never choose). Find it in data/presence-members.json, or via
# GET /api/presence/me with a device token. Blank disables /api/owner/roster.
OWNER_MEMBER_ID=
# How often the scheduled poller runs, in hours (default 12 = twice a day).
FORWARD_POLL_HOURS=12
# External sources the poller pulls from, comma-separated (keys from
# src/forwarding/sources/, e.g. "hackernews"). Empty = scheduler stays idle.
FORWARD_SOURCES=
